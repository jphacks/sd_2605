FROM node:22 AS frontend

WORKDIR /frontend

COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

COPY frontend/ ./
RUN npm run build

FROM ruby:3.3.11

RUN apt-get update -qq \
  && apt-get install -y --no-install-recommends build-essential libpq-dev \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app

ENV RAILS_ENV=production \
    BUNDLE_WITHOUT="development:test" \
    BUNDLE_DEPLOYMENT=1

COPY backend/Gemfile backend/Gemfile.lock ./
RUN bundle install && bundle exec bootsnap precompile -j 1 --gemfile

COPY backend/ ./
RUN bundle exec bootsnap precompile -j 1 app/ lib/

# public/ のファイルは1年キャッシュされるので、index.html だけは SpaController から no-cache で返す。
COPY --from=frontend /frontend/dist/ ./public/
RUN mkdir -p spa && mv public/index.html spa/index.html

EXPOSE 3000

CMD ["bash", "-c", "bundle exec rails db:prepare && exec bundle exec rails server -b 0.0.0.0 -p ${PORT:-3000}"]
